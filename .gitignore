# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Credentials — never commit
connections.toml
*.pat
*.pem
*.p8
.env
.env.*
.snowflake/
.streamlit/secrets.toml
secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# testing
/coverage

# Snowflake / tooling local state
.cortex/sessions/
deploy_log.txt
*.log

# Build artefacts — deploy.py repackages tide_decision.zip on every run
build/

# Staging scratch — never commit
_handoff/

# Snowflake CLI build output for the Streamlit app. `snow streamlit deploy`
# bundles the app under streamlit/output/ before uploading it to the stage;
# it is a copy of files already tracked elsewhere in streamlit/.
streamlit/output/

# PDFs are generated artefacts: status briefs, decks, reports. They are built
# from tracked sources and are read outside the repo, so none belong in git
# history. They were previously only *untracked*, which a single `git add .`
# would have undone. If one ever genuinely must be committed, `git add -f` it
# deliberately rather than deleting this rule.
*.pdf

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.suo
*.sw?
