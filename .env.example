# TIDE Local Development Environment
# Copy this file to .env and configure your local connection
# NOTE: The Streamlit app runs in Snowflake, so this is only for local testing
# and deployment scripts.

# Snowflake CLI connection name (from ~/.snowflake/connections.toml)
SNOWFLAKE_CONNECTION_NAME=tide

# Optional: Override roles for local testing
# TIDE_ROLE=TIDE_ADMIN
